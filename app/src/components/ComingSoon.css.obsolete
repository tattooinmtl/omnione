/* === ComingSoon / app shell stub ===
 * Three-pane placeholder so ENTER has somewhere to go. The actual
 * code editor + AI panel + preview are wired in a follow-up build.
 */

.coming {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.coming__backdrop {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.coming__shell {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
}

.coming__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 24px;
  border-bottom: 1px solid var(--border);
  font-size: 11px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--fg-dim);
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
}
.coming__brand {
  color: var(--blue-2);
  font-weight: 700;
  letter-spacing: 0.32em;
}

.coming__layout {
  flex: 1;
  display: grid;
  grid-template-columns: 280px 1fr 320px;
  gap: 12px;
  padding: 12px;
  min-height: 0;
}

.coming__panel {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  background: rgba(5, 8, 16, 0.72);
  backdrop-filter: blur(8px);
  padding: 16px;
  min-height: 0;
  overflow: hidden;
}

.coming__panel h2 {
  margin: 0 0 12px;
  font-family: var(--font-display);
  font-size: 12px;
  letter-spacing: 0.32em;
  color: var(--blue-2);
  text-transform: uppercase;
  border-bottom: 1px solid var(--border);
  padding-bottom: 8px;
}

.coming__stub {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-family: 'Space Mono', ui-monospace, monospace;
  font-size: 12px;
  color: var(--fg-dim);
  line-height: 1.6;
}
.coming__stub p { margin: 0; }

.coming__panel--center .coming__preview {
  border: 1px dashed var(--border);
  padding: 14px;
  background: rgba(0, 0, 0, 0.35);
}

.coming__bottombar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 24px;
  border-top: 1px solid var(--border);
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  font-size: 11px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--fg-dim);
}

.coming__back {
  padding: 8px 16px;
  font-size: 10px;
  letter-spacing: 0.28em;
  color: var(--blue-2);
  border: 1px solid var(--border);
  border-radius: 2px;
  transition: color 0.2s, border-color 0.2s, background 0.2s;
}
.coming__back:hover {
  color: white;
  border-color: var(--blue-2);
  background: rgba(95, 168, 255, 0.1);
}

.coming__status {
  color: var(--fg-dim);
}

@media (max-width: 1024px) {
  .coming__layout {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
  }
  .coming__panel--left,
  .coming__panel--right {
    max-height: 200px;
  }
}
