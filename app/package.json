{
  "name": "omnione",
  "private": true,
  "version": "0.5.2",
  "type": "module",
  "description": "OmniOne — a local AI agent with memory, moods, a heartbeat and a live face. Websim-style: prompt left, preview center, code editor on the go. React + Vite + Three.js.",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "api": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "serialport": "^13.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "supertest": "^7.2.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
