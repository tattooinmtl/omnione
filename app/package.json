{
  "name": "omnione",
  "private": true,
  "version": "0.16.1",
  "type": "module",
  "description": "OmniOne — a local AI agent with memory, moods, a heartbeat and a live face. Websim-style: prompt left, preview center, code editor on the go. React + Vite + Three.js.",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "prebuild": "node server/nodeVersion.js",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "api": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "serialport": "^13.0.0",
    "three": "^0.169.0",
    "unpdf": "^1.8.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.2.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
